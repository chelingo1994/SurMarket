<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentProductsList"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/titleHeight"
        android:orientation="horizontal"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        >
        <TextView
            android:id="@+id/TXV_FRGProductsList_Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/FRGProductsList_Title"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:gravity="center"
            />
        <ImageView
            android:id="@+id/IMV_FRGProductsList_ShoppingCart"
            android:layout_width="@dimen/imagenViewIconSize"
            android:layout_height="@dimen/imagenViewIconSize"
            android:clickable="true"
            android:contentDescription="@string/Shopping_Cart"
            android:focusable="true"
            android:padding="@dimen/imagenViewIcon_Padding"
            android:src="@drawable/ic_shopping_cart"

            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="16dp"

        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/cardview_controls"
            app:cardCornerRadius="@dimen/cardview_default_corner_radius"
            app:cardElevation="@dimen/cardview_default_elevation"
            app:cardBackgroundColor="@color/gray"
            >
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:paddingHorizontal="16dp"
                >
                <ImageView
                    android:id="@+id/IMV_FRGProductsList_Search"
                    android:layout_width="@dimen/imagenViewIconSize"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/Shopping_Shearch"
                    android:focusable="true"
                    android:padding="@dimen/imagenViewIcon_Padding"
                    android:src="@drawable/ic_shopping_search"

                    />
                <EditText
                    android:id="@+id/ETX_FRGProductsList_Search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/Shopping_Shearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="@dimen/textSize"

                    >

                </EditText>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <Button
        android:id="@+id/btn_FRGProductsList_Login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@drawable/bg_button_primary"
        android:minHeight="@dimen/height_button_min"
        android:text="@string/agregarTitle"
        android:textAllCaps="false"
        android:textColor="@color/color_background"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold" />
</LinearLayout>