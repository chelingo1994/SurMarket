<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cardview_default_buttom"
    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
    app:cardElevation="@dimen/cardview_default_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/padding_cardview_default">

        <!-- Textos y botón a la izquierda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/item_margin_Start">

            <TextView
                android:id="@+id/TXV_item_FRGProducts_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría: Abarrotes"
                android:textSize="@dimen/ITTextView_TextSize"
                android:layout_marginBottom="@dimen/item_margin_Bottom"/>

            <TextView
                android:id="@+id/TXV_item_FRGProducts_Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arroz"
                android:textStyle="bold"
                android:textSize="@dimen/ITTextView_TextSize"/>

            <TextView
                android:id="@+id/TXV_item_FRGProducts_Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio: 4.99 Bs"
                android:textSize="@dimen/ITTextView_TextSize"/>

            <Button
                android:id="@+id/BTN_item_FRGProducts_Buy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprar"
                android:textSize="@dimen/ITTextView_TextSize"
                android:padding="@dimen/button_padding_horizontal"/>

        </LinearLayout>

        <!-- Imagen a la derecha -->
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/cardview_image"
            android:layout_height="@dimen/cardview_image"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="@dimen/cardview_item_corner_radius"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/IMV_item_FRGProductsImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/product"
                android:src="@drawable/ic_surmarket"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>
