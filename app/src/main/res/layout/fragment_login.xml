<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Título -->
        <TextView
            android:id="@+id/txvLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loginTitle"
            android:textAlignment="center"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- Nombre de usuario -->
        <TextView
            android:id="@+id/txvLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/loginUsername"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body" />

        <EditText
            android:id="@+id/edtLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_input"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_input"
            android:hint="@string/loginUsernameHint"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingHorizontal="@dimen/spacing_md"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <!-- Contraseña -->
        <TextView
            android:id="@+id/txvLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/loginPassword"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body" />

        <EditText
            android:id="@+id/edtLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_input"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_input"
            android:hint="@string/loginPasswordHint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingHorizontal="@dimen/spacing_md"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <!-- Recuperar contraseña -->
        <TextView
            android:id="@+id/txvLoginForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/loginForgotPassword"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_small" />

        <!-- Empuja los botones al final de la pantalla -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botones -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_button_primary"
            android:minHeight="@dimen/height_button_min"
            android:text="@string/loginTitle"
            android:textAllCaps="false"
            android:textColor="@color/color_background"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="@dimen/height_button_min"
            android:text="@string/loginRegister"
            android:textAllCaps="false"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
