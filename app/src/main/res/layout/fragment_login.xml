<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Título -->
        <TextView
            android:id="@+id/txvLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loginTitle"
            android:textAlignment="center"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- Nombre de usuario -->
        <TextView
            android:id="@+id/txvLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/loginUsername"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/corner_radius_input"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/stroke_width_thin">

            <EditText
                android:id="@+id/edtLoginUsername"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:background="@null"
                android:hint="@string/loginUsernameHint"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Contraseña -->
        <TextView
            android:id="@+id/txvLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/loginPassword"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/corner_radius_input"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/stroke_width_thin">

            <EditText
                android:id="@+id/edtLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:background="@null"
                android:hint="@string/loginPasswordHint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Recuperar contraseña -->
        <TextView
            android:id="@+id/txvLoginForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/loginForgotPassword"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_small" />

        <!-- Empuja los botones al final de la pantalla -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:insetTop="@dimen/elevation_none"
            android:insetBottom="@dimen/elevation_none"
            android:minHeight="@dimen/height_button_min"
            android:text="@string/loginTitle"
            android:textAllCaps="false"
            android:textColor="@color/color_background"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="@dimen/corner_radius_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:insetTop="@dimen/elevation_none"
            android:insetBottom="@dimen/elevation_none"
            android:minHeight="@dimen/height_button_min"
            android:text="@string/loginRegister"
            android:textAllCaps="false"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:backgroundTint="@color/color_surface"
            app:cornerRadius="@dimen/corner_radius_button" />
    </LinearLayout>
</ScrollView>
